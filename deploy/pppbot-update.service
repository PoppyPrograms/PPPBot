[Unit]
Description=Pull and restart PPPBot when its image changes
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/pppbot
ExecStart=/usr/bin/docker compose --file /opt/pppbot/compose.yaml pull
ExecStart=/usr/bin/docker compose --file /opt/pppbot/compose.yaml up --detach --remove-orphans
